generator client {
    provider = "prisma-client-js"
    output   = "../../generated/dinein"
}

datasource db {
    provider = "postgresql"
}

enum TableStatus {
    AVAILABLE
    OCCUPIED
    RESERVED
    CLEANING
}

enum TableSessionStatus {
    ACTIVE
    CLOSED
}

enum ReservationStatus {
    PENDING
    CONFIRMED
    CANCELED
    COMPLETED
    NO_SHOW
}

enum PaymentMethod {
    CASH
    BANK_TRANSFER
}

model Table {
    id     String @id @default(uuid()) @db.Uuid
    number String @unique @db.VarChar(20)
    seats  Int

    status TableStatus @default(AVAILABLE)
    note   String?     @db.VarChar(255)
    qrCode String?     @db.VarChar(255)

    reservations Reservation[]
    sessions     TableSession[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status])
    @@map("tables")
}

model TableSession {
    id      String @id @default(uuid()) @db.Uuid
    tableId String @db.Uuid
    table   Table  @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    status        TableSessionStatus @default(ACTIVE)
    openedAt      DateTime           @default(now())
    closedAt      DateTime?
    paymentMethod PaymentMethod?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([tableId, status])
    @@map("table_sessions")
}

model Reservation {
    id      String @id @default(uuid()) @db.Uuid
    tableId String @db.Uuid
    table   Table  @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    userId     String? @db.VarChar(30)
    guestName  String  @db.VarChar(120)
    guestPhone String  @db.VarChar(20)
    partySize  Int

    scheduledAt DateTime
    note        String?  @db.Text

    status ReservationStatus @default(PENDING)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([tableId])
    @@index([userId])
    @@index([scheduledAt])
    @@index([status])
    @@map("reservations")
}
